# ==================================================
# DATABASE
# ==================================================
DATABASE_URL=postgresql://sms_outreach:sms_outreach@localhost:5432/sms_outreach?schema=public

# ==================================================
# TEXTBEE
# ==================================================
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_WEBHOOK_SECRET=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# ==================================================
# APP / TIMEZONE / PACING
# ==================================================
APP_TIMEZONE=Europe/Madrid

SEND_WINDOW_START=08:45
SEND_WINDOW_END=18:45
# Comma separated: MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY,SATURDAY,SUNDAY
ALLOWED_WEEKDAYS=MONDAY,TUESDAY,WEDNESDAY,THURSDAY,FRIDAY

MIN_SEND_GAP_SECONDS=600
MAX_SMS_PER_DAY=60

FOLLOWUP_1_DELAY_HOURS=48
FOLLOWUP_2_DELAY_HOURS=96

STALLED_AFTER_MINUTES=20
CIRCUIT_BREAKER_CONSECUTIVE_FAILURES=3
CIRCUIT_BREAKER_CONSECUTIVE_STALLED=3
CIRCUIT_BREAKER_API_ERRORS_WINDOW_MINUTES=15
CIRCUIT_BREAKER_API_ERRORS_THRESHOLD=5

SCHEDULER_INTERVAL_SECONDS=60
RECONCILIATION_INTERVAL_SECONDS=300
STALLED_CHECK_INTERVAL_SECONDS=300

# ==================================================
# SAFETY
# ==================================================
OUTREACH_DRY_RUN=true
ENVIRONMENT=development
# Comma separated E.164 numbers allowed to receive SMS when ENVIRONMENT != production
TEST_ALLOWED_NUMBERS=

# ==================================================
# ADMIN
# ==================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
PORT=3000

# Shared secret for the external cron trigger (cronjob.org -> POST /cron/tick).
# Required whenever the worker doesn't run as an always-on process (e.g. Vercel).
CRON_SECRET=

# ==================================================
# NOTIFICATIONS (optional)
# ==================================================
NOTIFY_DISCORD_WEBHOOK_URL=
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

LOG_LEVEL=info
